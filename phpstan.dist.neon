includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    phpVersion:
        min: 80200
        max: 80509
    paths:
        - src
        - ajax
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - tests/phpstan-shims/ShippingEntry.php
        - tests/stubs/Mcp/Server/Builder.php
        - tests/stubs/Mcp/Schema/Result/CallToolResult.php
        - tests/stubs/QUI/AI/MCP/ProviderInterface.php
        - tests/stubs/QUI/AI/MCP/Server.php
        - tests/stubs/QUI/AI/MCP/ToolHelper.php

    tipsOfTheDay: false
